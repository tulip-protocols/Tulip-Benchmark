arg_separator = ' ' multiple;
initial_level = authorization;
ignored_chars = '\r';

levels:
  level authorization:
    USER (arg == "$username" => level = authorization_login | _ => level = authorization),
    APOP (arg == "$apop_username_digest" => level = transaction | _ => level = authorization),
    PASS (_),
    NOOP (_),
    QUIT (_);

  level authorization_login:
    PASS (arg == "$password" => level = transaction | _ => level = authorization),
    USER (arg == "$username" => level = authorization_login | _ => level = authorization),
    NOOP (_),
    QUIT (_);

  level transaction:
    STAT,
    LIST (_),
    RETR (_),
    DELE (_),
    NOOP (_),
    RSET,
    QUIT (_);

  level update:
    QUIT (_);

syscall_monitor:
  refused:
    "Error: Unknown command",
    "Unauthorized",
    "-ERR.*";
